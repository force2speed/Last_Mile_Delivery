generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  DELIVERY_AGENT
}

enum AgentStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum BusinessType {
  B2B
  B2C
}

enum RouteType {
  INTRA_ZONE
  INTER_ZONE
}

enum PaymentType {
  PREPAID
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  CREATED
  PICKUP_SCHEDULED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String?
  googleId      String?  @unique
  fullName      String
  phone         String   @unique
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agentProfile            AgentProfile?
  ordersAsCustomer        Order[]         @relation("CustomerOrders")
  ordersAsAgent           Order[]         @relation("AgentOrders")
  trackingEventsAuthored  TrackingEvent[] @relation("TrackingActor")
  rateCardsCreated        RateCard[]      @relation("RateCardCreator")

  @@index([email])
  @@index([role])
  @@map("users")
}

model AgentProfile {
  id               String      @id @default(uuid())
  userId           String      @unique
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           AgentStatus @default(OFFLINE)
  currentLatitude  Decimal?    @db.Decimal(10, 7)
  currentLongitude Decimal?    @db.Decimal(10, 7)
  lastLocationAt   DateTime?
  currentZoneId    String?
  currentZone      Zone?       @relation(fields: [currentZoneId], references: [id], onDelete: SetNull)
  homeZoneId       String?
  homeZone         Zone?       @relation("AgentHomeZone", fields: [homeZoneId], references: [id], onDelete: SetNull)
  vehicleType      String?
  vehicleNumber    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([currentZoneId])
  @@map("agent_profiles")
}

model Zone {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  areas            Area[]
  agentsHere       AgentProfile[]
  agentsHomedHere  AgentProfile[] @relation("AgentHomeZone")
  pickupOrders     Order[]        @relation("PickupZone")
  dropOrders       Order[]        @relation("DropZone")

  @@index([code])
  @@map("zones")
}

model Area {
  id        String   @id @default(uuid())
  name      String
  pincode   String   @unique
  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  addresses Address[]

  @@index([pincode])
  @@index([zoneId])
  @@map("areas")
}

model Address {
  id          String   @id @default(uuid())
  label       String?
  street      String
  landmark    String?
  city        String
  state       String
  pincode     String
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  areaId      String
  area        Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  pickupOrders Order[] @relation("PickupAddress")
  dropOrders   Order[] @relation("DropAddress")

  @@index([pincode])
  @@map("addresses")
}

model RateCard {
  id           String       @id @default(uuid())
  name         String
  version      Int          @default(1)
  businessType BusinessType

  baseRateIntraZone   Decimal @db.Decimal(10, 2)
  perKgRateIntraZone  Decimal @db.Decimal(10, 2)
  baseRateInterZone   Decimal @db.Decimal(10, 2)
  perKgRateInterZone  Decimal @db.Decimal(10, 2)

  codSurchargeFlat    Decimal @db.Decimal(10, 2) @default(0)
  codSurchargePercent Decimal @db.Decimal(5, 2)  @default(0)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  createdById   String
  createdBy     User      @relation("RateCardCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]

  @@index([businessType, isActive])
  @@index([effectiveFrom, effectiveTo])
  @@map("rate_cards")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique @default(cuid())

  customerId  String
  customer    User        @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  agentId     String?
  agent       User?       @relation("AgentOrders", fields: [agentId], references: [id], onDelete: SetNull)

  pickupAddressId  String
  pickupAddress    Address   @relation("PickupAddress", fields: [pickupAddressId], references: [id], onDelete: Restrict)
  dropAddressId    String
  dropAddress      Address   @relation("DropAddress", fields: [dropAddressId], references: [id], onDelete: Restrict)

  pickupZoneId     String
  pickupZone       Zone      @relation("PickupZone", fields: [pickupZoneId], references: [id], onDelete: Restrict)
  dropZoneId       String
  dropZone         Zone      @relation("DropZone", fields: [dropZoneId], references: [id], onDelete: Restrict)
  routeType        RouteType

  lengthCm           Decimal   @db.Decimal(12, 2)
  breadthCm          Decimal   @db.Decimal(12, 2)
  heightCm           Decimal   @db.Decimal(12, 2)
  actualWeightKg     Decimal   @db.Decimal(12, 3)
  volumetricWeightKg Decimal   @db.Decimal(12, 3)
  billableWeightKg   Decimal   @db.Decimal(12, 3)

  businessType     BusinessType
  paymentType      PaymentType
  rateCardId       String
  rateCard         RateCard  @relation(fields: [rateCardId], references: [id], onDelete: Restrict)
  baseCharge       Decimal   @db.Decimal(14, 2)
  weightCharge     Decimal   @db.Decimal(14, 2)
  codSurcharge     Decimal   @db.Decimal(14, 2) @default(0)
  totalCharge      Decimal   @db.Decimal(14, 2)
  codCollectAmount Decimal?  @db.Decimal(14, 2)

  paymentIntentId  String?
  paymentStatus    PaymentStatus @default(PENDING)

  status           OrderStatus @default(CREATED)
  failureReason    String?
  failedAttempts   Int         @default(0)
  maxAttempts      Int         @default(3)

  scheduledPickupAt    DateTime?
  scheduledDeliveryAt  DateTime?
  deliveredAt          DateTime?

  parentOrderId  String?
  parentOrder    Order?      @relation("OrderReschedule", fields: [parentOrderId], references: [id], onDelete: SetNull)
  reschedules    Order[]     @relation("OrderReschedule")

  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  trackingHistory  TrackingEvent[]

  @@index([customerId])
  @@index([agentId])
  @@index([status])
  @@index([pickupZoneId])
  @@index([dropZoneId])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model TrackingEvent {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status     OrderStatus
  occurredAt DateTime    @default(now())
  actorId    String
  actor      User        @relation("TrackingActor", fields: [actorId], references: [id], onDelete: Restrict)
  latitude   Decimal?    @db.Decimal(10, 7)
  longitude  Decimal?    @db.Decimal(10, 7)
  notes      String?
  eventSource String?    @default("AGENT_APP")

  @@index([orderId])
  @@index([actorId])
  @@index([status])
  @@index([occurredAt])
  @@index([orderId, occurredAt])
  @@map("tracking_events")
}